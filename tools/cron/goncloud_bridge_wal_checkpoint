# GONCLOUD Bridge — WAL checkpoint diario para evitar crecimiento sin límite
# de bridge.db-wal (visto a 3.7GB el 2026-05-17).
# Se ejecuta a las 02:30 UTC, después del backup (02:00) y antes del
# cleanup semanal de los domingos (03:00).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# min  hour  dom  month  dow   user  command
30     2     *    *      *     root  /mnt/data/appdata/bridge/bridge_wal_checkpoint.sh >> /mnt/data/appdata/bridge/data/wal_checkpoint.log 2>&1
